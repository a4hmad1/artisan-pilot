{
    "name": "a4hmad1/artisan-pilot",
    "description": "Type pas, pam, pamm and other shortcuts instead of long Laravel Artisan commands.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "artisan",
        "cli",
        "shortcuts",
        "sail",
        "pail",
        "pilot"
    ],
    "homepage": "https://github.com/a4hmad1/artisan-pilot",
    "support": {
        "issues": "https://github.com/a4hmad1/artisan-pilot/issues",
        "source": "https://github.com/a4hmad1/artisan-pilot"
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "ArtisanShortcuts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanShortcuts\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pa",
        "bin/pas",
        "bin/pat",
        "bin/pad",
        "bin/paup",
        "bin/pam",
        "bin/pamf",
        "bin/pamm",
        "bin/pamc",
        "bin/parl",
        "bin/paoc",
        "bin/pilot"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/build",
            "/dist",
            "/tests",
            "/tools",
            "/.github",
            "/.phpunit.cache",
            "/.phpstan",
            "/composer.lock",
            "/phpunit.xml",
            "/phpstan.neon",
            "/phpcs.xml",
            "/.artisan-shortcuts.json",
            "/.artisan-shortcuts.json.lock"
        ]
    }
}
