{
    "name": "a4hmad1/artisan-pilot-fixture",
    "type": "project",
    "license": "MIT",
    "require": {
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/tinker": "^3.0",
        "a4hmad1/artisan-pilot": "@dev",
        "laravel/pail": "^1.2",
        "laravel/sail": "^1.41"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "a4hmad1/artisan-pilot": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": false,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.5",
        "brianium/paratest": "^7.4",
        "laravel/pint": "^1.20"
    }
}
